# --- Hindsight (required for real memory) ------------------------------------------
# Hindsight Cloud: create an API key at https://ui.hindsight.vectorize.io (promo code MEMHACK99 in Billing)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Or self-hosted:  docker compose up -d   then  HINDSIGHT_BASE_URL=http://localhost:8888  (no key)
HINDSIGHT_BANK_ID=godavari-ap

# --- LLM (Groq, OpenAI-compatible) ---------------------------------------------------
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Agent tuning ---------------------------------------------------------------------
AUTO_RESOLVE_CONFIDENCE=0.75
MINUTES_PER_EXCEPTION=18
